{
  "name": "concord",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "seed": "node tools/seed/src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "deploy:web": "CONCORD_HOST=concord.jaalip.com node tools/deploy/web.ts",
    "deploy:web:dev": "CONCORD_HOST=localhost node tools/deploy/web.ts",
    "deploy:stack": "CONCORD_HOST=localhost node tools/deploy/stack.ts",
    "deploy:spike:dev": "CONCORD_HOST=localhost node tools/deploy/spike.ts",
    "deploy:stack:prod": "CONCORD_HOST=concord.jaalip.com node tools/deploy/stack.ts",
    "live:prod": "CONCORD_HOST=concord.jaalip.com node",
    "dev": "pnpm --filter @concord/web dev",
    "verify": "node tools/verify.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "svelte": "5.57.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
